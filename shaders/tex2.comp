// Texture probes in compute; mode selects the sampler, each invocation one probe.
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform samplerCube cube;
layout(set = 0, binding = 1) uniform sampler3D vol;
layout(set = 0, binding = 2) uniform sampler2DArray arr;
layout(set = 0, binding = 3) uniform sampler2DShadow shadow;
layout(set = 0, binding = 4) uniform sampler2D gat;
layout(set = 0, binding = 5) uniform usampler2D itex;
layout(set = 0, binding = 6) uniform sampler2D ftex;
layout(set = 0, binding = 7) uniform sampler2D unnorm;
layout(set = 0, binding = 8) uniform sampler2D etc;
layout(std430, set = 0, binding = 9) buffer O { uvec4 v[]; } o;
layout(push_constant) uniform PC { uint mode, n; } pc;

uvec4 u8(vec4 c) { return uvec4(round(clamp(c, 0.0, 1.0) * 255.0)); }

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= pc.n)
		return;
	uvec4 r = uvec4(0);
	if (pc.mode == 0u) {            // cube: the 6 face directions
		vec3 d[6] = vec3[](vec3(1, 0, 0), vec3(-1, 0, 0), vec3(0, 1, 0),
				   vec3(0, -1, 0), vec3(0, 0, 1), vec3(0, 0, -1));
		r = u8(textureLod(cube, d[i % 6u], 0.0));
	} else if (pc.mode == 1u) {     // 3D 4x4x4: texel centres
		uvec3 t = uvec3(i % 4u, (i / 4u) % 4u, i / 16u);
		r = u8(textureLod(vol, (vec3(t) + 0.5) / 4.0, 0.0));
	} else if (pc.mode == 2u) {     // 2D array 4 layers: centre of each layer
		r = u8(textureLod(arr, vec3(0.5, 0.5, float(i % 4u)), 0.0));
	} else if (pc.mode == 3u) {     // shadow: compare refs 0.25 / 0.75 against 0.5
		r = u8(vec4(textureLod(shadow, vec3(0.5, 0.5, (i & 1u) == 0u ? 0.25 : 0.75), 0.0)));
	} else if (pc.mode == 4u) {     // gather the red channel of the 2x2 around (1,1)
		r = u8(textureGather(gat, vec2(1.0, 1.0) / 4.0, 0));
	} else if (pc.mode == 5u) {     // integer texelFetch
		r = texelFetch(itex, ivec2(i % 4u, i / 4u), 0);
	} else if (pc.mode == 6u) {     // float texture: exact bits
		r = floatBitsToUint(texelFetch(ftex, ivec2(i % 4u, i / 4u), 0));
	} else if (pc.mode == 7u) {     // unnormalized coordinates (texel centres)
		r = u8(textureLod(unnorm, vec2(float(i % 4u) + 0.5, float(i / 4u) + 0.5), 0.0));
	} else {                        // ETC2: one probe per texel of the 4x4 block
		r = u8(textureLod(etc, (vec2(i % 4u, i / 4u) + 0.5) / 4.0, 0.0));
	}
	o.v[i] = r;
}
