// Extra texture probes: cube array (mode 0), ASTC 4x4 (mode 1), aniso (mode 2).
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform samplerCubeArray cube_arr;
layout(set = 0, binding = 1) uniform sampler2D tex2d;
layout(std430, set = 0, binding = 2) buffer O { uvec4 v[]; } o;
layout(push_constant) uniform PC { uint mode, n; } pc;

uvec4 u8(vec4 c) { return uvec4(round(clamp(c, 0.0, 1.0) * 255.0)); }

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= pc.n)
		return;
	if (pc.mode == 0u) {
		vec3 d[6] = vec3[](vec3(1, 0, 0), vec3(-1, 0, 0), vec3(0, 1, 0),
				   vec3(0, -1, 0), vec3(0, 0, 1), vec3(0, 0, -1));
		o.v[i] = u8(textureLod(cube_arr, vec4(d[i % 6u], float(i / 6u)), 0.0));
	} else {
		o.v[i] = u8(textureLod(tex2d, (vec2(i % 4u, i / 4u) + 0.5) / 4.0, 0.0));
	}
}
