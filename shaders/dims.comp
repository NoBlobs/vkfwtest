// 3D dispatch: every invocation writes its linearised global id.
#version 450
layout(local_size_x = 4, local_size_y = 2, local_size_z = 2) in;
layout(std430, set = 0, binding = 0) buffer O { uint v[]; } o;
layout(push_constant) uniform PC { uvec4 size; } pc;     // global size in xyz

void main()
{
	uvec3 g = gl_GlobalInvocationID;
	o.v[(g.z * pc.size.y + g.y) * pc.size.x + g.x] = 0x10000u + g.x + g.y * 256u + g.z * 65536u;
}
